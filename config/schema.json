{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohansagark/ai-voice-bot/config/schema.json",
  "title": "AI Voice Bot site config",
  "description": "Application configuration synced to Cloudflare KV (key app_config). API keys are never in this file — they come from environment variables via sync.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allowedOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://[^/]+$"
      },
      "description": "Browser Origins allowed to call /chat, /tts, /lead in prod. Scheme + host (+ port) only — an Origin header never carries a path. Enforcement fails CLOSED: an empty or missing list denies every browser request.",
      "minItems": 1
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "botName": {
          "type": "string"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "role"
          ]
        },
        "bio": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instructions": {
          "type": "string",
          "description": "Optional freeform prompt notes from the site CMS."
        }
      },
      "required": [
        "botName",
        "owner",
        "bio",
        "tone",
        "facts",
        "do_not"
      ]
    },
    "instructions": {
      "type": "string",
      "description": "Top-level CMS instructions (preferred). Folded into the system prompt at runtime."
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxMessageChars": {
          "type": "integer",
          "minimum": 100
        },
        "maxTurnsPerSession": {
          "type": "integer",
          "minimum": 1
        },
        "ttsVoice": {
          "type": "string"
        },
        "maxTtsChars": {
          "type": "integer",
          "minimum": 100
        },
        "defaultProvider": {
          "type": "string"
        }
      },
      "description": "Runtime limits. `mode` is deliberately absent: it is the master enforcement switch and stays a Worker env var, so content edits can never disable the origin allowlist or rate limits."
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "description": "Public widget bootstrap only — safe to expose to the browser.",
      "properties": {
        "branding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "botName": {
              "type": "string"
            },
            "greeting": {
              "type": "string"
            },
            "themeColor": {
              "type": "string"
            },
            "themeColorSecondary": {
              "type": "string"
            },
            "position": {
              "type": "string"
            }
          }
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoGreet": {
              "type": "boolean"
            },
            "rememberReturning": {
              "type": "boolean"
            },
            "language": {
              "type": "string"
            },
            "proactiveGreet": {
              "type": "boolean"
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "consentText": {
              "type": "string"
            },
            "privacyPolicyUrl": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "speakByDefault": {
              "type": "boolean"
            },
            "ttsVoice": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "allowedOrigins",
    "persona"
  ]
}
